{
  "expo": {
    "name": "Cudi Cosmetics",
    "slug": "cudi-cosmetics",
    "scheme": "cudicometics",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "android": {
      "package": "com.cudicosmetics.shop",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#71384d"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 200,
          "backgroundColor": "#71384d"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "88bae6f3-2264-4d59-b84c-ddfd9cbdf28d"
      }
    }
  }
}
