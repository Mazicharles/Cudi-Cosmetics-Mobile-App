diff --git a/lib/auth/getRequestUser.ts b/lib/auth/getRequestUser.ts
new file mode 100644
index 0000000..5942737
--- /dev/null
+++ b/lib/auth/getRequestUser.ts
@@ -0,0 +1,25 @@
+import 'server-only';
+import { createClient } from '@supabase/supabase-js';
+import { serverDb } from '../supabase/server';
+
+/** A supplied token is authoritative: invalid tokens never fall back to cookies. */
+export async function getRequestUser(request: Request) {
+  const authorization = request.headers.get('authorization');
+  if (authorization !== null) {
+    const token = /^Bearer ([^\s]+)$/i.exec(authorization)?.[1];
+    const db = createClient(
+      process.env.NEXT_PUBLIC_SUPABASE_URL!,
+      process.env.NEXT_PUBLIC_SUPABASE_ANON_KEY!,
+      {
+        auth: { persistSession: false, autoRefreshToken: false },
+        global: { headers: token ? { Authorization: `Bearer ${token}` } : {} },
+      },
+    );
+    if (!token) return { db, user: null };
+    const { data, error } = await db.auth.getUser(token);
+    return { db, user: error ? null : data.user };
+  }
+  const db = await serverDb();
+  const { data, error } = await db.auth.getUser();
+  return { db, user: error ? null : data.user };
+}
